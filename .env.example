# Firebase Realtime Leaderboard Configuration
# Copy this file to .env or .env.local and add your Firebase credentials:

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=guess-the-country-xxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=guess-the-country-xxx
VITE_FIREBASE_STORAGE_BUCKET=guess-the-country-xxx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
